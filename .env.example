DISCORD_TOKEN=

# Optional: AI support (https://console.groq.com)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: Spotify links (metadata only — playback is YouTube)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional extra staff role ID, in addition to the role you pick in /setup
STAFF_BYPASS_ROLE_ID=

# Optional: OCR languages for reading text inside scam images. One worker serves
# every server, so list them all (e.g. eng+pol). Each downloads once on first use.
# OCR_LANGS=eng
